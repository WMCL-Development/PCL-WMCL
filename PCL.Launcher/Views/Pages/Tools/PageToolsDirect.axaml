<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:CompileBindings="False"
                x:Class="PCL.Views.Pages.Tools.PageToolsDirect">
    <ui:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <ui:MyCard Margin="0,0,0,15"
                       Title="{loc:Loc Tools.GameLink.Direct.Title}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Margin="0,0,0,10"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Tools.GameLink.Direct.Hint}" />
                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Tools.GameLink.Direct.Network}" />
                        <ui:MyTextBox Grid.Column="1"
                                      Text="{Binding DirectNetworkName, Mode=TwoWay}"
                                      Watermark="pcl-myroom" />
                    </Grid>
                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Tools.GameLink.Direct.Secret}" />
                        <ui:MyTextBox Grid.Column="1"
                                      Text="{Binding DirectNetworkSecret, Mode=TwoWay}"
                                      Watermark="{loc:Loc Tools.GameLink.Direct.Secret.Watermark}" />
                    </Grid>
                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Tools.GameLink.Direct.Peers}" />
                        <ui:MyTextBox Grid.Column="1"
                                      Text="{Binding DirectPeers, Mode=TwoWay}"
                                      Watermark="例如 tcp://game.udad.top:61123" />
                    </Grid>
                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Text="房主虚拟 IP" />
                        <ui:MyTextBox Grid.Column="1"
                                      Text="{Binding DirectHostIp, Mode=TwoWay}"
                                      Watermark="10.126.126.1（无虚拟网卡时填，用于端口转发）" />
                    </Grid>
                    <Grid ColumnDefinitions="120,*" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Text="本地端口" />
                        <ui:MyTextBox Grid.Column="1"
                                      Text="{Binding DirectLocalPort, Mode=TwoWay}"
                                      Watermark="25565" />
                    </Grid>
                    <WrapPanel>
                        <ui:MyButton MinWidth="110"
                                     Padding="13,0"
                                     Margin="0,0,12,0"
                                     Command="{Binding StartDirectCommand}"
                                     Text="{loc:Loc Tools.GameLink.Direct.Start}" />
                        <ui:MyButton MinWidth="110"
                                     Padding="13,0"
                                     Command="{Binding StopDirectCommand}"
                                     Text="{loc:Loc Tools.GameLink.Direct.Stop}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="{Binding DirectStatus}" />
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="房间成员"
                       IsVisible="{Binding HasDirectMembers}">
                <ItemsControl Margin="25,40,21,15"
                              ItemsSource="{Binding DirectMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock FontSize="11"
                                           Opacity="0.6"
                                           Text="{Binding Summary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
