<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                x:Class="PCL.Views.Pages.Tools.PageCollection">
    <Grid>
        <!-- 收藏库居中显示 -->
        <Border x:Name="PanContent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        <!-- 加载遮罩：铺满内容区并居中显示加载动画 -->
        <Panel x:Name="PanMask"
               IsVisible="False"
               Background="#B3FFFFFF">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ui:MyLoading Width="42"
                              Height="42"
                              HorizontalAlignment="Center" />
                <TextBlock x:Name="LabLoading"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Opacity="0.8" />
            </StackPanel>
        </Panel>
    </Grid>
</ui:MyPageRight>
