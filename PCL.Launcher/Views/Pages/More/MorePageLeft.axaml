<ui:MyPageLeft xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:PCL.UI.Controls"
               xmlns:loc="using:PCL.Core.UI"
               x:Class="PCL.Views.Pages.More.MorePageLeft">
    <ui:MyScrollViewer Classes="FullMargin"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanItem"
                    Margin="0,12,0,0">
            <TextBlock x:Name="TextToolsCategory"
                       Margin="13,5,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc More.Left.Tools}" />

            <ui:MyListItem x:Name="ItemToolbox"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/tool-case"
                           Title="{loc:Loc More.Left.Toolbox}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextInfoCategory"
                       Margin="13,10,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc More.Left.Info}" />

            <ui:MyListItem x:Name="ItemHelp"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/circle-help"
                           Title="{loc:Loc More.Left.Help}"
                           Type="RadioBox" />

            <ui:MyListItem x:Name="ItemAbout"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/info"
                           Title="{loc:Loc More.Left.About}"
                           Type="RadioBox" />

            <ui:MyListItem x:Name="ItemFeedback"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/message-circle"
                           Title="{loc:Loc More.Left.Feedback}"
                           Type="RadioBox" />
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageLeft>
