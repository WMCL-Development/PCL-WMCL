<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls"
        xmlns:skin="using:PCL.UI.Controls.Skin"
        xmlns:loc="using:PCL.Core.UI"
        x:Class="PCL.Views.Pages.Launch.SkinPanel">
    <!-- 左半 3D 模型，右半按钮；两半等比铺满，不再留大片空白。 -->
    <Grid ColumnDefinitions="*,420" Margin="12">
        <Border Grid.Column="0"
                CornerRadius="6"
                ClipToBounds="True"
                Background="{DynamicResource ColorBrushBg1}">
            <skin:SkinModelPreview x:Name="Model" />
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc Launch.Skin.Preview}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:MyButton x:Name="BtnFront" MinWidth="80" MinHeight="32" Padding="10,0" Text="{loc:Loc Launch.Skin.Front}" />
                <ui:MyButton x:Name="BtnBack" MinWidth="80" MinHeight="32" Padding="10,0" Text="{loc:Loc Launch.Skin.Back}" />
                <ui:MyButton x:Name="BtnReset" MinWidth="90" MinHeight="32" Padding="10,0" Text="{loc:Loc Launch.Skin.Reset}" />
            </StackPanel>

            <TextBlock x:Name="LabLocal"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Text="{loc:Loc Launch.Skin.LocalFile}" />
            <ui:MyButton x:Name="BtnPickSkin" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,0"
                         Text="{loc:Loc Launch.Skin.PickSkin}" />

            <TextBlock x:Name="LabAccount"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Text="{loc:Loc Launch.Skin.Account}" />
            <ui:MyButton x:Name="BtnUploadSkin" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,0"
                         Text="{loc:Loc Launch.Skin.UploadSkin}" />
            <ui:MyButton x:Name="BtnSaveSkin" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,0"
                         Text="{loc:Loc Launch.Skin.SaveAs}" />

            <TextBlock x:Name="LabEditor"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Text="{loc:Loc Launch.Skin.Editor}" />
            <ui:MyButton x:Name="BtnOpenEditor" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,0"
                         Text="{loc:Loc Launch.Skin.OpenEditor}" />

            <TextBlock x:Name="LabStatus"
                       Margin="0,8,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Opacity="0.75" />
        </StackPanel>
    </Grid>
</UserControl>
