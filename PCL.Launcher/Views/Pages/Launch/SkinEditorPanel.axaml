<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls"
        xmlns:skin="using:PCL.UI.Controls.Skin"
        xmlns:loc="using:PCL.Core.UI"
        x:Class="PCL.Views.Pages.Launch.SkinEditorPanel"
        MinWidth="720" MinHeight="480">
    <Grid ColumnDefinitions="*,260" Margin="12">
        <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                Background="{DynamicResource ColorBrushBg1}">
            <skin:SkinPixelEditor x:Name="Canvas" />
        </Border>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
            <StackPanel Spacing="8">
                <Border Height="180" CornerRadius="6" ClipToBounds="True"
                        Background="{DynamicResource ColorBrushBg1}">
                    <skin:SkinModelPreview x:Name="Preview" />
                </Border>

                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{loc:Loc Skin.Editor.Tools}" />
                <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <ui:MyButton x:Name="BtnBrush" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Brush}" />
                    <ui:MyButton x:Name="BtnEraser" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Eraser}" />
                    <ui:MyButton x:Name="BtnFill" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Fill}" />
                    <ui:MyButton x:Name="BtnPick" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Pick}" />
                    <ui:MyButton x:Name="BtnUndo" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Undo}" />
                    <ui:MyButton x:Name="BtnRedo" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Redo}" />
                    <ui:MyButton x:Name="BtnMirrorH" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.MirrorH}" />
                    <ui:MyButton x:Name="BtnMirrorV" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.MirrorV}" />
                    <ui:MyButton x:Name="BtnClear" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.Clear}" />
                    <ui:MyButton x:Name="BtnResetView" MinWidth="70" Padding="8,0" Text="{loc:Loc Skin.Editor.ResetView}" />
                </WrapPanel>

                <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Text="{loc:Loc Skin.Editor.Color}" />
                <WrapPanel x:Name="PanSwatches" ItemSpacing="4" LineSpacing="4" />

                <ui:MyButton x:Name="BtnSave" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                             Padding="10,0" Text="{loc:Loc Skin.Editor.Save}" />

                <TextBlock x:Name="LabStatus" FontSize="12" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
