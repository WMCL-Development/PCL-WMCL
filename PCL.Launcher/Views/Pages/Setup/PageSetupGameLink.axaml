<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:CompileBindings="False"
                x:Class="PCL.Views.Pages.Setup.PageSetupGameLink">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyCard Margin="0,15"
                       Title="{loc:Loc Setup.GameLink.Connection.Title}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Margin="0,0,0,10"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Setup.GameLink.Connection.Hint}" />
                    <ui:MyComboBox x:Name="ComboConnectionMethod"
                                   HorizontalAlignment="Stretch"
                                   SelectedIndex="{Binding ConnectionMethodIndex, Mode=TwoWay}">
                        <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Connection.Lobby}" />
                        <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Connection.Astral}" />
                        <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Connection.Terracotta}" />
                        <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Connection.EasyTier}" />
                    </ui:MyComboBox>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard x:Name="CardEasyTier" Margin="0,15"
                       Title="{loc:Loc Setup.GameLink.EasyTier.Title}">
                <StackPanel Margin="25,40,25,15"
                            Orientation="Vertical">
                    <TextBlock Margin="0,0,0,10"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Setup.GameLink.EasyTier.Shared}" />
                    <ui:MyHint Margin="0,0,0,10"
                               Theme="Yellow"
                               Text="{loc:Loc Setup.GameLink.RestartRequired}" />
                    <Grid ColumnDefinitions="Auto,8,*"
                          RowDefinitions="28,8,28,4,28,28,28,28">
                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.GameLink.Username}" />
                        <ui:MyTextBox x:Name="TextLinkUsername"
                                      Grid.Row="0"
                                      Grid.Column="2"
                                      Text="{Binding LinkUsername, Mode=TwoWay}"
                                      ToolTip.Tip="{loc:Loc Setup.GameLink.Username.ToolTip}" />

                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.GameLink.Protocol.Preference}" />
                        <ui:MyComboBox x:Name="ComboPreferProtocol"
                                       Grid.Row="2"
                                       Grid.Column="2"
                                       HorizontalAlignment="Stretch"
                                       SelectedIndex="{Binding PreferProtocolIndex, Mode=TwoWay}">
                            <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Protocol.Tcp}"
                                               ToolTip.Tip="{loc:Loc Setup.GameLink.Protocol.Tcp.ToolTip}" />
                            <ui:MyComboBoxItem Content="{loc:Loc Setup.GameLink.Protocol.Udp}"
                                               ToolTip.Tip="{loc:Loc Setup.GameLink.Protocol.Udp.ToolTip}" />
                        </ui:MyComboBox>

                        <ui:MyCheckBox x:Name="CheckLatencyFirstMode"
                                       Grid.Row="4"
                                       Grid.ColumnSpan="3"
                                       Checked="{Binding LatencyFirstMode, Mode=TwoWay}"
                                       Text="{loc:Loc Setup.GameLink.LatencyFirstMode}"
                                       ToolTip.Tip="{loc:Loc Setup.GameLink.LatencyFirstMode.ToolTip}" />
                        <ui:MyCheckBox x:Name="CheckTryPunchSym"
                                       Grid.Row="5"
                                       Grid.ColumnSpan="3"
                                       Checked="{Binding TryPunchSym, Mode=TwoWay}"
                                       Text="{loc:Loc Setup.GameLink.PortGuessNat}"
                                       ToolTip.Tip="{loc:Loc Setup.GameLink.PortGuessNat.ToolTip}" />
                        <ui:MyCheckBox x:Name="CheckEnableIPv6"
                                       Grid.Row="6"
                                       Grid.ColumnSpan="3"
                                       Checked="{Binding EnableIPv6, Mode=TwoWay}"
                                       Text="{loc:Loc Setup.GameLink.EnableIPv6}"
                                       ToolTip.Tip="{loc:Loc Setup.GameLink.EnableIPv6.ToolTip}" />
                        <ui:MyCheckBox x:Name="CheckEnableCliOutput"
                                       Grid.Row="7"
                                       Grid.ColumnSpan="3"
                                       Checked="{Binding EnableCliOutput, Mode=TwoWay}"
                                       Text="{loc:Loc Setup.GameLink.CliDebugOutput}"
                                       ToolTip.Tip="{loc:Loc Setup.GameLink.CliDebugOutput.ToolTip}" />
                    </Grid>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard x:Name="CardAstral" Margin="0,0,0,15"
                       Title="{loc:Loc Setup.GameLink.Astral.Title}">
                <StackPanel Margin="25,40,25,15"
                            Orientation="Vertical">
                    <Grid ColumnDefinitions="Auto,8,*"
                          RowDefinitions="28,8,28">
                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.GameLink.Astral.Username}" />
                        <ui:MyTextBox Grid.Row="0"
                                      Grid.Column="2"
                                      Text="{Binding AstralUsername, Mode=TwoWay}"
                                      ToolTip.Tip="{loc:Loc Setup.GameLink.Astral.Username.ToolTip}" />
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.GameLink.Astral.VirtualIp}" />
                        <ui:MyTextBox Grid.Row="2"
                                      Grid.Column="2"
                                      Text="{Binding AstralVirtualIp, Mode=TwoWay}"
                                      ToolTip.Tip="{loc:Loc Setup.GameLink.Astral.VirtualIp.ToolTip}" />
                    </Grid>

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Opacity="0.6"
                               Text="{loc:Loc Setup.GameLink.Astral.Relay.Hint}" />
                    <ListBox x:Name="ListAstralRelays"
                             MaxHeight="140"
                             ItemsSource="{Binding AstralRelays}"
                             SelectedItem="{Binding SelectedAstralRelay, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,10,0,0">
                        <ui:MyTextBox x:Name="TextAstralRelayUri"
                                      MinWidth="220"
                                      Watermark="tcp://host:11010"
                                      Text="{Binding NewAstralRelayUri, Mode=TwoWay}" />
                        <ui:MyTextBox x:Name="TextAstralRelayName"
                                      MinWidth="120"
                                      Margin="8,0,0,0"
                                      Watermark="{loc:Loc Setup.GameLink.Astral.Relay.Name}"
                                      Text="{Binding NewAstralRelayName, Mode=TwoWay}" />
                        <ui:MyButton x:Name="BtnAddAstralRelay"
                                     MinWidth="90"
                                     Padding="13,0"
                                     Margin="8,0,0,0"
                                     Command="{Binding AddAstralRelayCommand}"
                                     Text="{loc:Loc Setup.GameLink.Astral.Relay.Add}" />
                        <ui:MyButton x:Name="BtnRemoveAstralRelay"
                                     MinWidth="90"
                                     Padding="13,0"
                                     Margin="8,0,0,0"
                                     Command="{Binding RemoveAstralRelayCommand}"
                                     IsEnabled="{Binding CanRemoveRelay}"
                                     Text="{loc:Loc Setup.GameLink.Astral.Relay.Remove}" />
                    </WrapPanel>
                </StackPanel>
            </ui:MyCard>

            <!-- WPF 中该卡片默认折叠（Visibility=Collapsed）；真实 NAT/IPv6 检测在 Phase 3 接入。 -->
            <ui:MyCard x:Name="CardNetworkTest"
                       Margin="10"
                       IsVisible="False"
                       Title="{loc:Loc Setup.GameLink.NetworkTest.Title}">
                <StackPanel Margin="25,40,25,15"
                            Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TextUdpNatType"
                                   Grid.Row="0"
                                   Text="{Binding UdpNatTypeText}" />
                        <TextBlock x:Name="TextTcpNatType"
                                   Grid.Row="1"
                                   Text="{Binding TcpNatTypeText}" />
                        <TextBlock x:Name="TextIpv6Status"
                                   Grid.Row="2"
                                   Text="{Binding Ipv6StatusText}" />
                        <ui:MyButton x:Name="BtnNetTest"
                                     Grid.Row="4"
                                     Grid.ColumnSpan="3"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     ColorType="Highlight"
                                     IsEnabled="{Binding NetTestEnabled}"
                                     Text="{Binding NetTestButtonText}" />
                    </Grid>
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>