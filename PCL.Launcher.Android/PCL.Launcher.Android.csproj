<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>PCL CE</AssemblyTitle>
        <AssemblyName>PCL.Launcher.Android</AssemblyName>
        <Description>PCL CE 的 Android 宿主</Description>
        <Company>PCL Community</Company>
        <Product>PCL CE</Product>
        <RootNamespace>PCL.Android</RootNamespace>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-android</TargetFramework>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;Release</Configurations>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <ApplicationId>com.pclcommunity.pclce</ApplicationId>
    </PropertyGroup>
    <!-- 版本号唯一来源：PCL.Launcher/Resources/metadata.json。
         versionName 取 metadata.base；versionCode 默认 1000000（本地构建），
         CI/Release 会通过 -p:ApplicationVersion=1000000+run_number 覆盖，保证单调递增。 -->
    <PropertyGroup>
        <_MetadataJsonFile>$(MSBuildProjectDirectory)/../PCL.Launcher/Resources/metadata.json</_MetadataJsonFile>
        <_MetadataJsonText>$([System.IO.File]::ReadAllText($(_MetadataJsonFile)))</_MetadataJsonText>
        <_MetadataBaseVersion>$([System.Text.RegularExpressions.Regex]::Match($(_MetadataJsonText), '&quot;base&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_MetadataBaseVersion>
        <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$(_MetadataBaseVersion)</ApplicationDisplayVersion>
        <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1000000</ApplicationVersion>
    </PropertyGroup>
    <PropertyGroup>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <PublishReadyToRun>false</PublishReadyToRun>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>
    <!-- CoreCLR 运行时要求程序集不压缩；Sentry 的构建目标会硬性阻止该配置，
         这里用同名空目标覆盖它（仅影响打包检查，不影响 Sentry 功能）。 -->
    <Target Name="_SentryEnsureAndroidEnableAssemblyCompressionDisabled" />

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="12.1.6" />
        <!-- Sentry 的 buildTransitive 会禁止 AndroidEnableAssemblyCompression=false，
             而 CoreCLR 运行时需要未压缩的程序集，这里只取程序集本身、跳过其构建目标。 -->
        <PackageReference Include="Sentry" Version="6.6.0" ExcludeAssets="build;buildTransitive" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="SharpCompress" Version="0.50.1" />
    </ItemGroup>
    <ItemGroup>
        <!-- EasyTier 的 aarch64 静态二进制：以 lib*.so 形式打进 lib/arm64-v8a，
             安装后位于 nativeLibraryDir，具备可执行权限（Android 不允许执行应用数据目录里的文件）。 -->
        <!-- 二进制不提交进仓库：构建前运行 scripts/fetch-easytier-android.sh 下载。 -->
        <AndroidNativeLibrary Include="NativeLibs/arm64-v8a/libeasytier-cli.so"
                              Condition="Exists('NativeLibs/arm64-v8a/libeasytier-cli.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-arm64')" />
        <AndroidNativeLibrary Include="NativeLibs/arm64-v8a/libeasytier_ffi.so"
                              Condition="Exists('NativeLibs/arm64-v8a/libeasytier_ffi.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-arm64')" />
        <AndroidNativeLibrary Include="NativeLibs/x86_64/libeasytier-cli.so"
                              Condition="Exists('NativeLibs/x86_64/libeasytier-cli.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-x64')" />
        <AndroidNativeLibrary Include="NativeLibs/x86_64/libeasytier_ffi.so"
                              Condition="Exists('NativeLibs/x86_64/libeasytier_ffi.so') And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'android-x64')" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
        <ProjectReference Include="..\PCL.Core.UI\PCL.Core.UI.csproj" />
        <ProjectReference Include="..\PCL.Launcher.Core\PCL.Launcher.Core.csproj" />
        <ProjectReference Include="..\PCL.Localization\PCL.Localization.csproj" />
        <ProjectReference Include="..\PCL.Platform.Android\PCL.Platform.Android.csproj" />
        <!-- 直接复用桌面端 UI：页面、视图模型与样式都来自 PCL.Launcher。
             桌面端是 Exe，不能作为工程引用，这里直接引用其产物程序集。 -->
        <Reference Include="PCL.Launcher">
            <HintPath>..\PCL.Launcher\bin\$(Configuration)\net11.0\PCL.Launcher.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <!-- Compile the probe for HotSpot only. It is not an Android (ART) Java source or binding. -->
    <ItemGroup>
        <AndroidJavaSource Remove="JavaRuntime/Probe/WmclJvmProbe.java;Graphics/Probe/WmclLwjglProbe.java;Graphics/Probe/WmclDesktopGlProbe.java" />
    </ItemGroup>
    <Target Name="CompileWmclJvmProbe" DependsOnTargets="_ResolveSdks"
            Condition="'$(DesignTimeBuild)' != 'true'"
            Inputs="$(MSBuildProjectFullPath);JavaRuntime/Probe/WmclJvmProbe.java"
            Outputs="$(IntermediateOutputPath)jvm-probe/WmclJvmProbe.class">
        <MakeDir Directories="$(IntermediateOutputPath)jvm-probe" />
        <Exec Command="&quot;$(_JavaSdkDirectory)/bin/javac&quot; --release 8 -Xlint:-options -encoding UTF-8 -d &quot;$(IntermediateOutputPath)jvm-probe&quot; &quot;JavaRuntime/Probe/WmclJvmProbe.java&quot;" />
        <ItemGroup>
            <FileWrites Include="$(IntermediateOutputPath)jvm-probe/WmclJvmProbe.class" />
        </ItemGroup>
    </Target>
    <!-- Opt-in diagnostic only. Keep the HotSpot jar out of ART/DEX and the .so in nativeLibraryDir. -->
    <ItemGroup Condition="'$(WmclLwjglProbeAssets)' != '' And '$(RuntimeIdentifier)' == 'android-arm64'">
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/liblwjgl.so" Abi="arm64-v8a" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libwmcl_glfw.so" Abi="arm64-v8a" />
        <AndroidNativeLibraryNoJniPreload Include="liblwjgl.so;libwmcl_glfw.so" />
        <!-- Optional game natives: packaged only when the probe assets carry them. -->
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libGL.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/libGL.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libmobileglues.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/libmobileglues.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libopenal.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/libopenal.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/liblwjgl_opengl.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/liblwjgl_opengl.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/liblwjgl_stb.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/liblwjgl_stb.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/liblwjgl_tinyfd.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/liblwjgl_tinyfd.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libfreetype.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/libfreetype.so')" />
        <AndroidNativeLibrary Include="$(WmclLwjglProbeAssets)/libshaderc.so" Abi="arm64-v8a"
                              Condition="Exists('$(WmclLwjglProbeAssets)/libshaderc.so')" />
        <AndroidNativeLibraryNoJniPreload Include="libGL.so;libmobileglues.so;libopenal.so;liblwjgl_opengl.so;liblwjgl_stb.so;liblwjgl_tinyfd.so;libfreetype.so;libshaderc.so" />
        <AndroidAsset Include="$(WmclLwjglProbeAssets)/licenses/**/*" Link="lwjgl-probe/licenses/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <Target Name="BuildWmclLwjglProbe" DependsOnTargets="_ResolveSdks" BeforeTargets="AssignTargetPaths"
            Condition="'$(DesignTimeBuild)' != 'true' And '$(WmclLwjglProbeAssets)' != ''">
        <Error Condition="'$(RuntimeIdentifier)' != 'android-arm64'" Text="The opt-in LWJGL probe requires an android-arm64 APK." />
        <Error Condition="!Exists('$(WmclLwjglProbeAssets)/liblwjgl.so') Or !Exists('$(WmclLwjglProbeAssets)/libwmcl_glfw.so')
                        Or !Exists('$(WmclLwjglProbeAssets)/lwjgl-3.3.3.jar') Or !Exists('$(WmclLwjglProbeAssets)/lwjgl-glfw-3.3.3.jar')"
               Text="Prepare the opt-in LWJGL assets with scripts/fetch-lwjgl-probe-android.sh and build the GLFW shim." />
        <MakeDir Directories="$(IntermediateOutputPath)lwjgl-probe" />
        <Exec Command="&quot;$(_JavaSdkDirectory)/bin/javac&quot; --release 8 -Xlint:-options -encoding UTF-8 -cp &quot;$(WmclLwjglProbeAssets)/lwjgl-3.3.3.jar&#58;$(WmclLwjglProbeAssets)/lwjgl-glfw-3.3.3.jar&#58;$(WmclLwjglProbeAssets)/lwjgl-opengl-3.3.3.jar&quot; -d &quot;$(IntermediateOutputPath)lwjgl-probe&quot; &quot;Graphics/Probe/WmclLwjglProbe.java&quot; &quot;Graphics/Probe/WmclDesktopGlProbe.java&quot;" />
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)lwjgl-probe/WmclLwjglProbe.class" LogicalName="WmclLwjglProbe.class" />
            <EmbeddedResource Include="$(IntermediateOutputPath)lwjgl-probe/WmclDesktopGlProbe.class" LogicalName="WmclDesktopGlProbe.class" />
            <EmbeddedResource Include="$(WmclLwjglProbeAssets)/lwjgl-3.3.3.jar" LogicalName="wmcl.lwjgl-3.3.3.jar" />
            <EmbeddedResource Include="$(WmclLwjglProbeAssets)/lwjgl-glfw-3.3.3.jar" LogicalName="wmcl.lwjgl-glfw-3.3.3.jar" />
            <EmbeddedResource Include="$(WmclLwjglProbeAssets)/lwjgl-opengl-3.3.3.jar" LogicalName="wmcl.lwjgl-opengl-3.3.3.jar"
                              Condition="Exists('$(WmclLwjglProbeAssets)/lwjgl-opengl-3.3.3.jar')" />
            <FileWrites Include="$(IntermediateOutputPath)lwjgl-probe/WmclLwjglProbe.class" />
            <FileWrites Include="$(IntermediateOutputPath)lwjgl-probe/WmclDesktopGlProbe.class" />
        </ItemGroup>
    </Target>
    <Target Name="AddWmclJvmProbeResource" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileWmclJvmProbe"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)jvm-probe/WmclJvmProbe.class" LogicalName="WmclJvmProbe.class" />
        </ItemGroup>
    </Target>
</Project>
